# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local secrets — never commit credentials
.env
.env.local
.env*
# Keep the safe variable template in version control.
!.env.example

# local database files
*.db
*.db-journal
*.sqlite
*.sqlite3

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Atlas reference assets (original source files)
data/reference-source/

# Locally generated reference indexes (review before committing)
data/reference-index/reference-families.json
data/reference-index/reference-embeddings.json

# Generated thumbnails (future)
data/thumbnails/

# Future embedding cache
data/embeddings/

# Hidden local evaluation mapping
/evaluation/review-key.json
