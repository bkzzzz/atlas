generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AssetKind {
  REFERENCE
  GENERATED
}

// This model is the first persistent data owned by Atlas.
model Character {
  id          String           @id @default(cuid())
  name        String
  description String
  personality String
  species     String
  createdAt   DateTime         @default(now())
  assets      ImageAsset[]
  memory      CharacterMemory?
}

// An asset is a reference or generated image associated with one character.
// onDelete: Cascade removes its database row with the character; Blob lifecycle
// cleanup remains the responsibility of application deletion flows.
model ImageAsset {
  id                  String     @id @default(cuid())
  characterId         String
  character           Character  @relation(fields: [characterId], references: [id], onDelete: Cascade)
  name                String
  imageUrl            String
  blobPathname        String?
  mimeType            String?
  byteSize            Int?
  type                String
  provider            String
  status              String
  prompt              String?
  feedback            String?
  kind                AssetKind?
  anonymousOwnerKey   String?
  generationRequestId String?    @unique
  model               String?
  sourcePrompt        String?
  compiledPrompt      String?
  generationSettings  Json?
  createdAt           DateTime   @default(now())

  @@index([characterId, kind, createdAt])
  @@index([anonymousOwnerKey, kind, createdAt, id])
}

// One durable memory record stores the human-approved character context.
// characterId is unique to enforce one memory record per character.
model CharacterMemory {
  id              String    @id @default(cuid())
  characterId     String    @unique
  character       Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  visualStyle     String?
  lore            String?
  designRules     String?
  approvedSummary String?
  rejectedSummary String?
  preferredPrompt String?
  lastUpdated     DateTime  @updatedAt
}
